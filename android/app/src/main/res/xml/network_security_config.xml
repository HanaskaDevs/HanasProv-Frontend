<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Intermedio de GoGetSSL (emisor de *.hanaska.com, firmado por
                 USERTrust RSA, vence 2028-09-05). El servidor HTTPS del
                 dominio entrega solo su certificado, sin este intermedio:
                 las PCs lo completan solas, Android no, y la app fallaba al
                 conectar (no cargaban los videos ni el login). Se puede
                 quitar cuando el servidor entregue la cadena completa. -->
            <certificates src="@raw/gogetssl_rsa_dv_ca" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.100.60.170</domain>
    </domain-config>

</network-security-config>